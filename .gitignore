# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Environment / secrets — never commit real values. See .env.example.
.env
.env.*
!.env.example
secrets/
credentials/
*.pem
*.p12
*.pfx
*.cer
*.crt

# Android / iOS signing — real keystores and credentials never belong in
# source control (android/.gitignore also covers the android/ subtree;
# these root-level patterns are defense in depth for any future platform
# folder that isn't Flutter-templated with its own .gitignore).
key.properties
*.keystore
*.jks
GoogleService-Info.plist
google-services.json

# AI assistant tooling (Claude Code) — local/session config, not required
# by every contributor. Revisit if the team decides to share it instead.
.claude/

# OS junk files
Thumbs.db
desktop.ini
ehthumbs.db

# Local databases / debug artifacts
*.db
*.sqlite
*.sqlite3
*.hprof

# Node — local-only cache for the Supabase CLI (installed via `npm
# install --no-save supabase`, see supabase/tests/verify_backend.sh).
# Never committed; regenerated on demand.
node_modules/

# Local Supabase CLI runtime state — regenerated by `supabase start`/
# `db reset` on every machine. Includes generated local env secrets
# (edge-runtime docker.env) that must never enter git history, even
# though they're the CLI's own well-known local-dev defaults.
supabase/.branches/
supabase/.temp/

# Golden-test failure output (flutter test writes these next to goldens/
# only when a golden comparison fails — never the approved images
# themselves, which live in goldens/ and stay tracked). Scoped to the
# actual golden-test layout, not a bare **/failures/ — that wildcard
# previously also swallowed lib/features/ai_coach/domain/failures/ (a
# legitimate domain "failure type" directory, unrelated to golden
# tests), silently keeping ai_coach_failure.dart untracked for an
# entire branch's worth of commits without ever showing up in `git
# status` (Roadmap Item 14 integration checkpoint, discovered via a
# clean-clone CI failure that a locally-still-present-but-ignored file
# had been masking).
test/features/*/golden/failures/
