# Forge — environment reference
#
# IMPORTANT: this file is documentation only. Forge does not read .env files
# at runtime (no dotenv package is wired in) — every value below is actually
# supplied at build/run time via `--dart-define`, read by
# lib/core/config/app_config.dart through `String.fromEnvironment`. Copy the
# values you need into your own `flutter run --dart-define=...` command or
# your IDE's run configuration; do not expect this file to be loaded
# automatically.
#
# Never put real secrets in a file like this one. As of this writing, Forge
# has no value here that's actually a secret — see the note on
# SUPABASE_ANON_KEY below — but the placeholder pattern is kept in case that
# changes.

# --- App mode -----------------------------------------------------------
# "mock" (default) runs entirely offline against in-memory/local mock data.
# No backend, no credentials, no network calls. "live" is reserved for once
# a real backend exists; nothing in the app reads it yet.
APP_ENV=mock

# --- Supabase (public client configuration, not implemented yet) --------
# Only used when APP_ENV=live, which nothing in this codebase currently
# does. The anon key is a PUBLIC client key by Supabase's own design —
# access control is enforced server-side by Row Level Security, not by
# keeping this value secret. It is still left blank here rather than
# checked in, because it's project-specific, not because it's sensitive.
# A Supabase *service-role* key must never appear in this file, in
# --dart-define, or anywhere in this repository — that one really is a
# secret and belongs only in server-side backend configuration.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- AI provider (not implemented yet) -----------------------------------
# The Character / Daily Transmission system is entirely deterministic mock
# dialogue today — no AI provider is called anywhere in this codebase. These
# are placeholders for the roadmap item that wires one in.
AI_PROVIDER=mock
OLLAMA_BASE_URL=
