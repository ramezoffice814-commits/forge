<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Roadmap Item 20: normal, auto-granted (not runtime-prompted)
         permission required for any network call (Supabase Auth/REST/
         Realtime/Edge Functions) once APP_ENV=live is ever used.
         `debug`/`profile` build variants already declare this via
         their own overlay manifests (for the Flutter tool's hot-reload
         connection), but that does NOT carry over to `release` — with
         no declaration here, a release build had no path to networking
         at all (a real device would refuse the socket at the OS level)
         and no plugin's own manifest supplies it either. Invisible
         until now because the app has only ever run in mock mode. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Roadmap Item 17: runtime-requested on Android 13+ only via
         PluginLocalNotificationService.requestPermission(), never
         auto-granted — declaring it here is required for the request
         API to exist at all, it does not itself show anything. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <application
        android:label="forge"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
